// Esquema do EMPREST.AI.
//
// Implementado: Perfil (BE-02), Equipamento (BE-03) e Emprestimo (BE-04),
// a partir da BE-01 §3. O que o Prisma não expressa (índice único parcial,
// check, triggers) está escrito à mão nas migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Espelho local de auth.users: o que o Supabase não sabe sobre a pessoa.
/// A linha é criada pelo backend no primeiro request autenticado (BE-02 §4).
model Perfil {
  id       String   @id @db.Uuid // = auth.users.id
  nome     String
  papel    Papel    @default(colaborador)
  criadoEm DateTime @default(now()) @map("criado_em")

  emprestimos Emprestimo[]

  @@map("perfil")
}

enum Papel {
  colaborador
  operacoes

  @@map("papel")
}

/// Item do acervo (BE-01 §3, BE-03 §2). "Emprestado" não é situação guardada:
/// é a existência de um empréstimo aberto (BE-01 §3).
model Equipamento {
  id            String         @id @default(uuid()) @db.Uuid
  nome          String
  categoria     Categoria
  patrimonio    String         @unique
  situacao      SituacaoFisica @default(disponivel)
  observacao    String?
  /// Caminho no bucket (equipamentos/TI-0001.jpg), não a URL: a URL pública
  /// é montada na hora a partir de SUPABASE_URL e STORAGE_NAME.
  imagemCaminho String?        @map("imagem_caminho")
  imagemAutor   String?        @map("imagem_autor")
  imagemOrigem  String?        @map("imagem_origem")
  imagemLicenca String?        @map("imagem_licenca")
  criadoEm      DateTime       @default(now()) @map("criado_em")

  emprestimos Emprestimo[]

  @@map("equipamento")
}

/// Empréstimo (BE-01 §3, BE-04 §2). Aberto enquanto `devolvidoEm` é nulo.
/// Datas sem hora: o dia em São Paulo (BE-04 §4).
model Emprestimo {
  id            String      @id @default(uuid()) @db.Uuid
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id])
  equipamentoId String      @map("equipamento_id") @db.Uuid
  perfil        Perfil      @relation(fields: [perfilId], references: [id])
  perfilId      String      @map("perfil_id") @db.Uuid
  retiradaEm    DateTime    @map("retirada_em") @db.Date
  devolverAte   DateTime    @map("devolver_ate") @db.Date
  devolvidoEm   DateTime?   @map("devolvido_em") @db.Date

  @@index([perfilId])
  @@map("emprestimo")
}

enum Categoria {
  notebook
  monitor
  cabo
  camera
  acessorio

  @@map("categoria")
}

enum SituacaoFisica {
  disponivel
  manutencao

  @@map("situacao_fisica")
}
