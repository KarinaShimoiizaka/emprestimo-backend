# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# EMPREST.AI — backend (NestJS + Prisma)
#
# ATENÇÃO: ainda não existe código em application/backend/ — nem
# package.json, nem src/, nem prisma/schema.prisma. Este DockerFile está
# escrito para o layout que o ADR-001 define e passa a funcionar assim que o
# projeto Nest for criado. Até lá, o serviço `backend` do compose fica atrás
# do profile `backend` e não sobe por padrão.
#
# Dois alvos:
#   --target dev     desenvolvimento, com watch (é o que o compose usa)
#   --target runner  produção, só dist/ e as dependências de runtime
# ---------------------------------------------------------------------------

FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat


# --- dependências ----------------------------------------------------------
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci


# --- desenvolvimento -------------------------------------------------------
FROM base AS dev
ENV NODE_ENV=development
# O watcher do Nest precisa de polling para enxergar bind mount no Windows.
ENV CHOKIDAR_USEPOLLING=true
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Gera o Prisma Client a partir do schema; sem isso o import de @prisma/client
# falha em tempo de execução.
RUN npx prisma generate
EXPOSE 3001
CMD ["npm", "run", "start:dev"]


# --- build de produção -----------------------------------------------------
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate
RUN npm run build
# Descarta as dependências de desenvolvimento do node_modules que será copiado.
RUN npm prune --omit=dev


# --- produção --------------------------------------------------------------
FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3001

RUN addgroup -g 1001 -S nodejs && adduser -u 1001 -S nest -G nodejs

COPY --from=builder --chown=nest:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nest:nodejs /app/dist ./dist
COPY --from=builder --chown=nest:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nest:nodejs /app/package.json ./package.json

USER nest
EXPOSE 3001
CMD ["node", "dist/main"]
